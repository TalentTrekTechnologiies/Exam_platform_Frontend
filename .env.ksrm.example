# ─────────────────────────────────────────────────────────────────────────────
#  KSRM deployment — the exam module of the KSRM website
# ─────────────────────────────────────────────────────────────────────────────
#  Copy to `.env.production` before `npm run build`.
#
#  With these set the product presents itself as KSRM's own examination module:
#  no institution sign-up, no third-party platform name, KSRM branding on the
#  screens candidates and staff actually see.

# Serve the app under a subpath of the main site. Every asset URL and the
# router's basename derive from this, so it is the single switch that moves the
# whole app. Leave unset to serve from a domain root instead.
VITE_BASE_PATH=/online/

# Where the Spring Boot API is reachable. Must be https in production, or the
# browser blocks every request from an https page as mixed content.
# Under the subpath deployment nginx proxies this to the backend on :8080.
VITE_API_URL=https://ksrmce.ac.in/online/api

# Pins this build to KSRM. Candidates then type only their hall ticket and name,
# and the sign-in page shows the KSRM name and logo.
# Use the code returned when the KSRM admin account was created.
VITE_INSTITUTION_CODE=ksrm-college

# No self-registration. The staff accounts are created by KSRM, not signed up
# for. The server enforces this as well — see app.registration.enabled.
VITE_ALLOW_REGISTRATION=false

# What the product calls itself where no college name applies.
VITE_PLATFORM_NAME=KSRM Examinations
